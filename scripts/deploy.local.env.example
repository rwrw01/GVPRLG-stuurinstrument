# Copy to scripts/deploy.local.env (untracked, see .gitignore) and fill in the real values.
# Sourced by scripts/deploy.sh; plain shell assignments only.

# SSH target of the VPS (user@host, reachable via the management VPN).
VPS_HOST="<user>@<beheer-adres VPS>"
# Directory on the VPS that holds the operational docker-compose.yml, .env and secrets/.
COMPOSE_DIR="<pad naar de compose-map op de VPS>"
# Issuer of the Keycloak realm; the login redirect is checked against it after a deploy.
KEYCLOAK_ISSUER="https://<keycloak-host>/realms/gvprlg"

# Optional overrides.
# DOMAIN="spinnenweb.gvprlg.nl"
# VPS_PLATFORM="arm64"
